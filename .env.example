# Copy to .env and fill in.
#
# IMPORTANT: any variable prefixed NEXT_PUBLIC_ is inlined into the
# browser bundle at build time and is readable by anyone who loads the
# app. Never put a secret behind that prefix. Server-only values (used in
# route handlers and server components) must omit it.

# --- public: safe to ship to the browser ---
# Backend API base. Must include the /api/v1 suffix.
NEXT_PUBLIC_SERVER_URL=http://localhost:5000/api/v1

# Cube Cloud analytics. Note this token IS exposed to the browser by
# design; scope it to read-only and rotate it on expiry.
NEXT_PUBLIC_CUBE_API_URL=
NEXT_PUBLIC_CUBE_API_TOKEN=

# --- server only: never prefix these with NEXT_PUBLIC_ ---
OPENAI_API_KEY=
OPENAI_GPT_MODEL=gpt-4o-mini

NODE_ENV=development
